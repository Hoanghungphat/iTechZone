// prisma/schema.prisma
// Schema cho ITechZone

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// PRODUCT
// ================================
model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  brand         String
  brandName     String
  category      String
  price         Int
  originalPrice Int
  stock         Int      @default(0)
  image         String?
  thumbnail     String?
  images        String[]
  rating        Float    @default(0)
  sold          Int      @default(0)
  status        String   @default("active")

  isNew         Boolean  @default(false)
  isBestseller  Boolean  @default(false)
  isFlashSale   Boolean  @default(false)
  isFeatured    Boolean  @default(false)

  variants      Json?
  specs         Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]

  @@map("products")
  @@index([category])
  @@index([brand])
  @@index([status])
  @@index([slug])
}

// ================================
// USER
// ================================
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  avatar    String?
  role      String   @default("user")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  cart      CartItem[]
  reviews   Review[]
  addresses Address[]
  requestsMade     ApprovalRequest[] @relation("RequestedBy")
  requestsReviewed ApprovalRequest[] @relation("ReviewedBy")
  activityLogs     ActivityLog[]
  passwordResets   PasswordResetRequest[]

  @@map("users")
  @@index([email])
}

// ================================
// ADDRESS
// ================================
model Address {
  id        String  @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  province  String
  district  String
  ward      String
  street    String
  isDefault Boolean @default(false)

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ================================
// CART
// ================================
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  variant   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

// ================================
// ORDER
// ================================
model Order {
  id              String   @id @default(cuid())
  userId          String
  status          String   @default("pending")
  totalAmount     Int
  note            String?
  shippingName    String
  shippingPhone   String
  shippingAddress String
  paymentMethod   String   @default("cod")
  paymentStatus   String   @default("unpaid")
  paymentProof    String?  // URL/base64 ảnh chứng minh chuyển khoản
  version         Int      @default(0)  // optimistic locking
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@map("orders")
  @@index([userId])
  @@index([status])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?  // nullable: nếu sản phẩm bị xóa, order history vẫn giữ
  productName  String
  productImage String?
  variant      Json?
  quantity     Int
  price        Int

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

// ================================
// REVIEW
// ================================
model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("reviews")
  @@index([productId])
}

// ================================
// APPROVAL REQUEST (Staff workflow)
// ================================
model ApprovalRequest {
  id            String   @id @default(cuid())
  type          String   // DELETE_PRODUCT | EDIT_USER
  status        String   @default("pending")  // pending | approved | rejected
  requestedById String
  reviewedById  String?
  targetId      String   // productId or userId
  targetName    String   // tên sản phẩm/user để hiển thị
  payload       Json?    // dữ liệu muốn thay đổi (cho EDIT_USER)
  note          String?  // ghi chú của staff
  reviewNote    String?  // ghi chú của admin khi duyệt/từ chối
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requestedBy   User     @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy    User?    @relation("ReviewedBy",  fields: [reviewedById],  references: [id], onDelete: SetNull)

  @@map("approval_requests")
  @@index([status])
  @@index([requestedById])
}

// ================================
// ACTIVITY LOG
// ================================
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  userName   String   // cached tại thời điểm thực hiện
  userRole   String   // admin | staff
  action     String   // UPDATE_ORDER_STATUS | APPROVE_REQUEST | REJECT_REQUEST | DELETE_PRODUCT ...
  targetType String?  // order | product | user | request
  targetId   String?
  detail     String?  // mô tả ngắn gọn
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
  @@index([createdAt])
  @@index([userId])
}

// ================================
// PASSWORD RESET REQUEST (quên mật khẩu qua admin)
// ================================
model PasswordResetRequest {
  id           String    @id @default(cuid())
  userId       String
  status       String    @default("pending") // pending | completed | cancelled
  tempPassword String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_requests")
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ================================
// BANNER (trang chủ)
// ================================
model Banner {
  id            String   @id @default(cuid())
  tag           String                               // VD: "Galaxy AI"
  title         String                               // VD: "Samsung S24 Ultra"
  subtitle      String   @default("")
  price         Int      @default(0)
  originalPrice Int      @default(0)
  ctaText       String   @default("Khám phá")
  href          String   @default("/")
  image         String   @default("")
  gradient      String   @default("from-dark-900 via-dark-800 to-dark-900")
  accent        String   @default("#e51c1c")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("banners")
}
